@baseUrl = http://localhost:5002/api/auth
@host = http://localhost:5002

###############################################
# Health Check
###############################################
GET {{host}}/api/health

###############################################
# Seed Note:
# Run: npm run prisma:seed
# This creates/updates the following accounts with bcrypt-hashed passwords:
#   ADMIN:      admin@gmail.com      / Password123
#   COUNSELOR:  counselor@gmail.com  / Password123
#   CLIENT:     client@gmail.com     / Password123
# Existing admin@test.com / Password123 is preserved.
###############################################

###############################################
# Login - ADMIN (admin@gmail.com)
###############################################
### Login as ADMIN
# @name adminGmailLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@gmail.com",
  "password": "Password123"
}

###
@adminGmailToken = {{adminGmailLogin.response.body.data.token}}

###############################################
# Login - COUNSELOR (counselor@gmail.com)
###############################################
### Login as COUNSELOR
# @name counselorGmailLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "counselor@gmail.com",
  "password": "Password123"
}

###
@counselorGmailToken = {{counselorGmailLogin.response.body.data.token}}

###############################################
# Login - CLIENT (client@gmail.com)
###############################################
### Login as CLIENT
# @name clientGmailLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "client@gmail.com",
  "password": "Password123"
}

###
@clientGmailToken = {{clientGmailLogin.response.body.data.token}}

###############################################
# Verify Role in Login Response
###############################################
### Verify ADMIN role returned
GET {{baseUrl}}/me
Authorization: Bearer {{adminGmailToken}}

### Verify COUNSELOR role returned
GET {{baseUrl}}/me
Authorization: Bearer {{counselorGmailToken}}

### Verify CLIENT role returned
GET {{baseUrl}}/me
Authorization: Bearer {{clientGmailToken}}

###############################################
