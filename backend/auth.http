@host = http://localhost:5002
@baseUrl = {{host}}/api/auth

###############################################
# Test Credentials
###############################################
# CLIENT:    client@test.com    / Password123
# COUNSELOR: counselor@test.com / Password123
# ADMIN:     admin@test.com     / Password123

###############################################
# Register Test Users
###############################################

### Register CLIENT
# @name registerClient
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "client@test.com",
  "password": "Password123",
  "firstName": "Test",
  "lastName": "Client",
  "phone": "+1234567890",
  "role": "CLIENT"
}

### Register COUNSELOR
# @name registerCounselor
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "counselor@test.com",
  "password": "Password123",
  "firstName": "Test",
  "lastName": "Counselor",
  "phone": "+1234567891",
  "role": "COUNSELOR"
}

### Register ADMIN
# @name registerAdmin
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Password123",
  "firstName": "Test",
  "lastName": "Admin",
  "phone": "+1234567892",
  "role": "ADMIN"
}

###############################################
# Login Test Users
###############################################

### Login CLIENT
# @name clientLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "client@test.com",
  "password": "Password123"
}

###
@clientToken = {{clientLogin.response.body.data.token}}

### Login COUNSELOR
# @name counselorLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "counselor@test.com",
  "password": "Password123"
}

###
@counselorToken = {{counselorLogin.response.body.data.token}}

### Login ADMIN
# @name adminLogin
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Password123"
}

###
@adminToken = {{adminLogin.response.body.data.token}}

###############################################
# Current User (Me)
###############################################

### Get current user (CLIENT)
GET {{baseUrl}}/me
Authorization: Bearer {{clientToken}}

###############################################
# Auth Error Tests
###############################################

### Invalid login (wrong password)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "client@test.com",
  "password": "WrongPassword"
}

### Invalid login (non-existent email)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "does.not.exist@test.com",
  "password": "Password123"
}

### Me with missing token
GET {{baseUrl}}/me

### Me with invalid token
GET {{baseUrl}}/me
Authorization: Bearer this.is.not.a.valid.jwt

### Me with malformed Authorization header
GET {{baseUrl}}/me
Authorization: NotBearer sometoken

### Register validation error (invalid email + short password)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "email": "not-an-email",
  "password": "123",
  "firstName": "",
  "lastName": ""
}

###############################################
# Role-Based Authorization Tests
###############################################

### CLIENT -> /api/client/test (expected 200)
GET {{host}}/api/client/test
Authorization: Bearer {{clientToken}}

### CLIENT -> /api/counselor/test (expected 403)
GET {{host}}/api/counselor/test
Authorization: Bearer {{clientToken}}

### CLIENT -> /api/admin/test (expected 403)
GET {{host}}/api/admin/test
Authorization: Bearer {{clientToken}}

### COUNSELOR -> /api/counselor/test (expected 200)
GET {{host}}/api/counselor/test
Authorization: Bearer {{counselorToken}}

### COUNSELOR -> /api/admin/test (expected 403)
GET {{host}}/api/admin/test
Authorization: Bearer {{counselorToken}}

### ADMIN -> /api/admin/test (expected 200)
GET {{host}}/api/admin/test
Authorization: Bearer {{adminToken}}

### ADMIN -> /api/client/test (expected 403)
GET {{host}}/api/client/test
Authorization: Bearer {{adminToken}}

### Missing token -> /api/admin/test (expected 401)
GET {{host}}/api/admin/test

### Invalid token -> /api/admin/test (expected 401)
GET {{host}}/api/admin/test
Authorization: Bearer this.is.not.a.valid.jwt

### Missing token -> /api/counselor/test (expected 401)
GET {{host}}/api/counselor/test

### Missing token -> /api/client/test (expected 401)
GET {{host}}/api/client/test
